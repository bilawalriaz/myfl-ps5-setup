# Upstream sets file capabilities for port 53. We bind high ports and remove them.
FROM coredns/coredns:1.13.1@sha256:9b9128672209474da07c91439bf15ed704ae05ad918dd6454e5b6ae14e35fee6 AS upstream
FROM nginx@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752 AS clean
COPY --from=upstream /coredns /tmp/coredns
# Plain cp deliberately omits extended attributes; COPY alone retained file caps.
RUN cp /tmp/coredns /tmp/coredns.clean
FROM scratch
COPY --from=clean /tmp/coredns.clean /coredns
USER 65532:65532
ENTRYPOINT ["/coredns"]
