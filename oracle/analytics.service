[Unit]
Description=Private myfl HTTP and DNS aggregate snapshot
After=myfl-ps5.service
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=DOCKER_CONFIG=/opt/myfl-ps5/.cache/docker-client
ExecStart=/usr/bin/python3 /opt/myfl-ps5/scripts/collect_analytics.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myfl-ps5-analytics
